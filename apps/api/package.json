{
  "name": "@linksmith/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:production": "node dist/migrate.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "dotenv": "18.0.6",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  }
}
