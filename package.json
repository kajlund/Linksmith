{
  "name": "linksmith",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm start -w @linksmith/api",
    "dev": "concurrently --kill-others-on-fail -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:client": "npm run dev:web",
    "build": "npm run build -w @linksmith/web && npm run build -w @linksmith/api",
    "migrate": "npm run migrate -w @linksmith/api",
    "migrate:production": "npm run migrate:production -w @linksmith/api",
    "check": "npm run typecheck",
    "test": "npm test --workspaces --if-present",
    "dev:api": "npm run dev -w @linksmith/api",
    "dev:web": "npm run dev -w @linksmith/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:start": "node scripts/verify-start.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript-eslint": "8.69.0",
    "globals": "14.0.0"
  }
}
