{
  "name": "linksmith",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm start -w @linksmith/api",
    "dev": "concurrently --kill-others-on-fail -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:client": "npm run dev:web",
    "build": "npm run build --workspaces --if-present",
    "migrate": "npm run migrate -w @linksmith/api",
    "migrate:production": "npm run migrate:production -w @linksmith/api",
    "check": "npm run typecheck",
    "test": "npm test --workspaces --if-present",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "dev:api": "npm run dev -w @linksmith/api",
    "dev:web": "npm run dev -w @linksmith/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "concurrently": "^10.0.5"
  }
}
