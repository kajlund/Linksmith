# Copy to .env in the repository root. dotenv loads it automatically.
# Existing shell/service variables take precedence over file values.
# Use your PostgreSQL server hostname/IP when the database is not on this PC.
DATABASE_URL=postgres://linksmith:CHANGE_ME@YOUR_DATABASE_HOST:5432/linksmith?sslmode=disable
BIND_ADDR=127.0.0.1:8080
# Relative paths resolve from apps/api/, regardless of the working directory.
CLIENT_DIR=../web/dist
NODE_ENV=development
LOG_LEVEL=info
# Optional override: defaults to true in development, false in production.
# LOG_PRETTY=true
# Optional alternative dotenv file, relative to your process working directory.
# ENV_FILE=/path/to/linksmith.env
